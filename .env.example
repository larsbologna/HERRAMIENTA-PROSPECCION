# Opcional: copiá este archivo como .env para personalizar.
# (Tu nombre y ciudad para los mensajes se configuran desde la app: Configuración.)

# Puerto de la herramienta
PORT=3000

# Interfaz donde escucha. 127.0.0.1 = solo esta máquina (recomendado también en un VPS, detrás de Nginx).
HOST=127.0.0.1

# Carpeta de datos (base de datos SQLite y diagnósticos)
DATA_DIR=./data

# "false" para ver el navegador mientras analiza
HEADLESS=true

# Revisar el Instagram del negocio (bio, link de la bio y Linktree) antes de armar argumentos. "false" para desactivarlo.
INSTAGRAM_CHECK=true

# Tiempo máximo de una búsqueda del Generador de Prospectos (ms). Al cumplirse entrega lo encontrado.
GENERATOR_TIMEOUT_MS=900000

# ---------------------------------------------------------------- VPS / acceso remoto
# "true" detrás de Nginx o Cloudflare: usa X-Forwarded-* y CF-Connecting-IP para IP real y HTTPS.
TRUST_PROXY=false

# URL pública con la que entran los usuarios (ej.: https://crm.tudominio.com)
PUBLIC_URL=

# Cookie de sesión con "Secure": auto (si llegó por HTTPS) | true | false
COOKIE_SECURE=auto

# Días que dura la sesión sin volver a iniciar (se renueva con el uso)
SESSION_DAYS=30

# Código para crear el PRIMER administrador desde el navegador en un VPS.
# Generalo con:  openssl rand -hex 16   — y borralo después de crear el administrador.
# (Alternativa sin token: npm run usuarios -- crear --usuario ivan --nombre "Iván" --rol admin)
SETUP_TOKEN=
