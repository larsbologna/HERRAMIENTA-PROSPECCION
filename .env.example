# Puerto del servidor local
PORT=3000

# Carpeta donde se guardan informes, capturas y feedback del sistema QR
DATA_DIR=./data

# Datos del vendedor (se usan en el mensaje comercial de WhatsApp)
SELLER_NAME=Tu Nombre
SELLER_BUSINESS=Gestor de Presencia Online

# Navegador: "false" para ver el navegador mientras analiza (útil para depurar)
HEADLESS=true
# Ruta opcional a un Chromium propio (si no, usa el de Playwright)
# CHROMIUM_EXECUTABLE_PATH=

# Idioma con el que se abre Google Maps
MAPS_LANGUAGE=es

# URL pública con la que se generan los QR de reseñas (por defecto http://localhost:PORT)
# PUBLIC_BASE_URL=https://tu-dominio.com

# Integración con FÁBRICA DE AGENTES IA (opcional)
# Si se define, cada informe terminado se envía por POST a esta URL.
# AGENT_FACTORY_WEBHOOK_URL=https://mi-fabrica.local/api/prospectos
# AGENT_FACTORY_TOKEN=
# Agentes remotos que enriquecen el análisis (separados por coma). Cada uno recibe
# el contexto del análisis por POST y puede devolver hallazgos, resumen o mensaje.
# AGENT_ENDPOINTS=https://mi-fabrica.local/agents/copywriter,https://mi-fabrica.local/agents/seo
